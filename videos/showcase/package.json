{
  "name": "mcpkit-showcase",
  "version": "1.0.0",
  "description": "AIUI MCPKit interactive examples promotional film",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MCPKitShowcase ../../docs/assets/mcpkit-showcase.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p",
    "render:nobgm": "remotion render src/index.ts MCPKitShowcase ../../docs/assets/mcpkit-showcase-nobgm.mp4 --props=props-nobgm.json --codec=h264 --crf=20 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts MCPKitShowcase",
    "typecheck": "tsc --noEmit",
    "render:all": "node scripts/render-all.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
