{
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.2.0",
    "@yodaos-pkg/ink": "0.20.0-daily.20261027171530",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "playwright": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "playwright": { "optional": true }
  },
  "name": "@yodaos-pkg/aiui-mcpkit",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p benchmarks/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "bench": "node benchmarks/run.mjs",
    "prepack": "npm run build",
    "build:examples": "npm run build && node scripts/build-examples.mjs",
    "update:examples": "npm run build:examples && node scripts/update-examples.mjs",
    "watch:examples": "npm run build && node scripts/watch-examples.mjs",
    "diagnose:examples": "node scripts/diagnose-examples.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "start:examples": "node scripts/start-examples.mjs",
    "capture:examples": "node scripts/capture-examples.mjs",
    "capture:modes": "node scripts/capture-modes.mjs"
  },
  "description": "Build MCP App plugins from AIUI Agents.",
  "files": [
    "dist/index.mjs",
    "dist/*.d.ts",
    "dist/tools.mjs",
    "dist/state.mjs",
    "dist/runtime"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/runtime/business-tools.d.ts",
      "import": "./dist/tools.mjs"
    },
    "./state": {
      "types": "./dist/runtime/state.d.ts",
      "import": "./dist/state.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  }
}
