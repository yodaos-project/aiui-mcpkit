{
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@yodaos-pkg/ink": "^0.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "name": "@yodaos-pkg/aiui-mcpkit",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p benchmarks/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "bench": "node benchmarks/run.mjs",
    "prepack": "npm run build",
    "build:examples": "npm run build && node scripts/build-examples.mjs",
    "update:examples": "npm run build:examples && node scripts/update-examples.mjs",
    "start:examples": "node scripts/start-examples.mjs"
  },
  "description": "Build MCP App plugins from AIUI Agents.",
  "files": [
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/tools.mjs",
    "dist/runtime"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/runtime/business-tools.d.ts",
      "import": "./dist/tools.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  }
}
